<Window x:Class="ClipVault.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipVault settings" Width="660" Height="470" MinWidth="660" MaxWidth="660" MinHeight="470" MaxHeight="470"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Foreground="{DynamicResource Fg}" FontFamily="{StaticResource UiFont}" FontSize="13">

    <!-- Borderless, with Windows' glass background; the top strip drags the window -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <!-- One setting group, drawn as a soft card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Sidebar section button -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="bg" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}" Visibility="Hidden"/>
                            <StackPanel Orientation="Horizontal" Margin="12,8">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Surface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Margin="12,14,8,12">
            <StackPanel Orientation="Horizontal" Margin="8,0,0,22">
                <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}">
                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ClipVault" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="General" Tag="&#xE713;"
                         GroupName="Nav" IsChecked="True" Checked="OnNav"/>
            <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Content="Appearance" Tag="&#xE790;"
                         GroupName="Nav" Checked="OnNav"/>
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Content="History" Tag="&#xE81C;"
                         GroupName="Nav" Checked="OnNav"/>
            <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Content="Updates" Tag="&#xE895;"
                         GroupName="Nav" Checked="OnNav"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" VerticalAlignment="Bottom" Margin="22,0,0,20" FontSize="11" Foreground="{DynamicResource Muted}"/>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Height="58">
                <TextBlock x:Name="PageTitle" Text="General" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                           FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="44" Height="34" Content="&#xE8BB;" FontSize="10"
                        Style="{StaticResource IconButton}" ToolTip="Close" Click="OnCancel"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,10,18,0">
                <Grid>
                    <!-- General -->
                    <StackPanel x:Name="PageGeneral">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Shortcut to open ClipVault" Style="{StaticResource Label}"/>
                                <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" IsReadOnly="True" Cursor="Hand"
                                         IsReadOnlyCaretVisible="False" FontWeight="SemiBold"
                                         PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"/>
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Text="Click the box, then press the new key combination."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Open the popup at" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OpenCaret" GroupName="Open" Style="{StaticResource OutlinedChip}" Content="Text cursor"/>
                                    <RadioButton x:Name="OpenMouse" GroupName="Open" Style="{StaticResource OutlinedChip}" Content="Mouse"/>
                                    <RadioButton x:Name="OpenLast" GroupName="Open" Style="{StaticResource OutlinedChip}" Content="Where I left it"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Text cursor falls back to the mouse when an app doesn't report its cursor. To move the popup, drag the empty space next to the tabs or in the footer."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Pasting" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="CleanLinksBox" Style="{StaticResource Check}" Content="Remove tracking from copied links"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Strips things like ?utm_source= and &amp;fbclid= the moment you copy a link."/>
                                <TextBlock Text="Always paste plain text into these apps" Margin="0,14,0,7"/>
                                <TextBox x:Name="PlainAppsBox" Style="{StaticResource Field}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="App names separated by commas, e.g. code, notepad, windowsterminal. You can also tick this from the ⋯ menu in the popup."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <CheckBox x:Name="StartupBox" Style="{StaticResource Check}" Content="Start ClipVault when Windows starts"/>
                        </Border>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource OutlinedChip}" Content="Follow Windows"/>
                                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource OutlinedChip}" Content="Dark"/>
                                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource OutlinedChip}" Content="Light"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AccentBox" Style="{StaticResource Check}" Content="Use my Windows accent color"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Highlights follow the color picked in Windows Settings › Personalization › Colors."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="LinkIconsBox" Style="{StaticResource Check}" Content="Show website icons on links"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Downloads each site's icon once, directly from that site."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="CompactBox" Style="{StaticResource Check}" Content="Compact list (one line per item)"/>
                                <CheckBox x:Name="SoundsBox" Style="{StaticResource Check}" Content="Play a soft sound when copying and pasting" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersion" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="Not checked yet."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="CheckNowButton" Content="Check now" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdates"/>
                                    <Button x:Name="InstallButton" Content="Restart and update" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                            Click="OnInstallUpdate" Visibility="Collapsed"/>
                                    <Button Content="What's new" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnReleaseNotes"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource Check}" Content="Update automatically"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Checks GitHub every few hours. New versions are verified, then installed quietly the next time the popup closes."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- History -->
                    <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="History size" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="HistoryBox" Style="{StaticResource Field}" Width="90" PreviewTextInput="OnDigitsOnly"/>
                                    <TextBlock Text="items kept" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Pinned items are always kept and don't count toward this."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,18,18">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnSave" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
