<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 target gives access to Windows' built-in text recognition (OCR). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClipVault</AssemblyName>
    <RootNamespace>ClipVault</RootNamespace>
    <!-- Release version. Bumped by release.ps1; GitHub builds pass the tag version in. -->
    <Version>1.1.3</Version>
    <Product>ClipVault</Product>
    <!-- Exe icon for Explorer, the taskbar and task managers. Redraw with: python assets/make_icon.py -->
    <ApplicationIcon>assets\ClipVault.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon for the windows' title-bar / Alt+Tab icon -->
    <Resource Include="assets\ClipVault.ico" />
    <None Remove="assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>
