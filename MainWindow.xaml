<Window x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipVault"
        Title="ClipVault" Icon="/assets/ClipVault.ico" Width="440" Height="580" MinWidth="360" MinHeight="400" MaxWidth="1100" MaxHeight="1500"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Fg}"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">

    <!-- Borderless window that keeps Windows' own glass background, rounded corners and shadow -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:NullToVisibility x:Key="NullVis"/>
        <local:CardIs x:Key="CardIs"/>

        <!-- Pin button: hidden until hover/selection, always shown (accent) when pinned -->
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE718;"/>
            <Setter Property="ToolTip" Value="Pin (Ctrl+P)"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Content" Value="&#xE840;"/>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="ToolTip" Value="Unpin (Ctrl+P)"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One-click card action (open link / show file / save image), shown on hover like the pin -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasQuickAction}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Link">
                    <Setter Property="Content" Value="&#xE8A7;"/>
                    <Setter Property="ToolTip" Value="Open link (Ctrl+O)"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Files">
                    <Setter Property="Content" Value="&#xE838;"/>
                    <Setter Property="ToolTip" Value="Show in File Explorer (Ctrl+O)"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Image">
                    <Setter Property="Content" Value="&#xE74E;"/>
                    <Setter Property="ToolTip" Value="Save to file (Ctrl+S)"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small icon in a card's lead box; hidden when there's none or a photo fills the box -->
        <Style x:Key="LeadIcon" TargetType="Image">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LeadImage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LeadPhoto}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Info tag in a row header ("67 lines", "formatted") -->
        <DataTemplate x:Key="InfoTag">
            <Border CornerRadius="4" Padding="5,0,5,1" Margin="0,0,4,0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
            </Border>
        </DataTemplate>

        <!-- Quick-paste number badge, hidden past 9 -->
        <Style x:Key="Badge" TargetType="Border" BasedOn="{StaticResource KeyCap}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="Paste" InputGestureText="Enter" Click="Menu_Paste"/>
            <MenuItem Header="Paste as plain text" InputGestureText="Shift+Enter" Click="Menu_PastePlain"
                      IsEnabled="{Binding IsTextLike}"/>
            <MenuItem Header="Paste as" IsEnabled="{Binding IsTextLike}">
                <MenuItem Header="UPPERCASE" Tag="upper" Click="Menu_Transform"/>
                <MenuItem Header="lowercase" Tag="lower" Click="Menu_Transform"/>
                <MenuItem Header="Title Case" Tag="title" Click="Menu_Transform"/>
                <MenuItem Header="Trimmed spaces" Tag="trim" Click="Menu_Transform"/>
                <MenuItem Header="Single line" Tag="single" Click="Menu_Transform"/>
            </MenuItem>
            <MenuItem Header="Copy only" InputGestureText="Ctrl+Enter" Click="Menu_Copy"/>
            <Separator/>
            <MenuItem Header="Open link" InputGestureText="Ctrl+O" Click="Menu_Action"
                      Visibility="{Binding Card, Converter={StaticResource CardIs}, ConverterParameter=Link}"/>
            <MenuItem Header="Show in File Explorer" InputGestureText="Ctrl+O" Click="Menu_Action"
                      Visibility="{Binding Card, Converter={StaticResource CardIs}, ConverterParameter=Files}"/>
            <MenuItem Header="Copy color as" Visibility="{Binding Card, Converter={StaticResource CardIs}, ConverterParameter=Color}">
                <MenuItem Header="{Binding ColorHex}" InputGestureText="HEX" Tag="hex" Click="Menu_ColorAs"/>
                <MenuItem Header="{Binding ColorRgb}" InputGestureText="RGB" Tag="rgb" Click="Menu_ColorAs"/>
                <MenuItem Header="{Binding ColorHsl}" InputGestureText="HSL" Tag="hsl" Click="Menu_ColorAs"/>
            </MenuItem>
            <MenuItem Header="Open QR code link" Click="Menu_OpenQr"
                      Visibility="{Binding QrIsLink, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Copy QR code text" Click="Menu_CopyQr"
                      Visibility="{Binding HasQr, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Copy text from image" Click="Menu_CopyImageText" IsEnabled="{Binding HasOcrText}"
                      Visibility="{Binding Card, Converter={StaticResource CardIs}, ConverterParameter=Image}"/>
            <MenuItem Header="Save to file…" InputGestureText="Ctrl+S" Click="Menu_SaveFile"
                      Visibility="{Binding CanSaveToFile, Converter={StaticResource BoolVis}}"/>
            <Separator/>
            <MenuItem Header="Preview" InputGestureText="Space" Click="Menu_Preview"/>
            <MenuItem Header="Edit…" InputGestureText="F2" Click="Menu_Edit" IsEnabled="{Binding CanEdit}"/>
            <MenuItem Header="Pin / unpin" InputGestureText="Ctrl+P" Click="Menu_Pin"/>
            <Separator/>
            <MenuItem Header="Delete" InputGestureText="Del" Click="Menu_Delete"/>
        </ContextMenu>

        <!-- Hover tooltip: more of the text, or a bigger image -->
        <ToolTip x:Key="ItemTip" x:Shared="False" Content="{Binding}" MaxWidth="520">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding TipText}" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="12"
                                   Visibility="{Binding IsTextLike, Converter={StaticResource BoolVis}}"/>
                        <Image Source="{Binding FullImage}" MaxWidth="480" MaxHeight="360" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>

        <!-- List row: soft hover/selected fills that fade, plus an accent pill on the selected row -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="14,9,6,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
            <Setter Property="ToolTip" Value="{StaticResource ItemTip}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="900"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="ToolTipService.HorizontalOffset" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="hover" CornerRadius="6" Background="{DynamicResource Hover}" Opacity="0"/>
                            <Border x:Name="sel" CornerRadius="6" Background="{DynamicResource Selected}" Opacity="0"/>
                            <!-- Divider between entries -->
                            <Border Height="1" VerticalAlignment="Bottom" Margin="14,0,6,0" Background="{DynamicResource Line}"/>
                            <!-- Stripe in the item's type color; full strength when selected -->
                            <Border x:Name="pill" Width="3" CornerRadius="1.5" Background="{Binding TypeBrush}"
                                    HorizontalAlignment="Left" Margin="2,8,0,9" Opacity="0.55"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemMouseDown"/>
            <EventSetter Event="MouseMove" Handler="OnItemMouseMove"/>
        </Style>

        <!-- Compact list row: tighter padding -->
        <Style x:Key="CompactRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource RowStyle}">
            <Setter Property="Padding" Value="14,5,6,6"/>
        </Style>

        <!-- Image grid tile: accent frame when selected -->
        <Style x:Key="TileStyle" TargetType="ListBoxItem" BasedOn="{StaticResource RowStyle}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="ToolTipService.Placement" Value="Mouse"/>
            <Setter Property="ToolTipService.HorizontalOffset" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="frame" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Line}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel">
            <UniformGrid Columns="3" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>

        <!-- List row content, with smart cards for colors, links, emails, phone numbers, code and files -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:ClipItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Badge}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" Style="{StaticResource KeyCapText}"/>
                </Border>

                <Grid x:Name="Lead" Grid.Row="1" Grid.Column="1" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <Border x:Name="LeadBox" CornerRadius="7" Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                    <TextBlock x:Name="LeadGlyph" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding LeadImage, Converter={StaticResource NullVis}, ConverterParameter=invert}"/>
                    <Image Source="{Binding LeadImage}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"
                           Style="{StaticResource LeadIcon}"/>
                    <Border CornerRadius="7" Visibility="{Binding LeadPhoto, Converter={StaticResource BoolVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding LeadImage}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Header across the whole row: app, type tag, info tags, time -->
                <Grid Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,6,5" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding SourceIcon}" Width="12" Height="12" Margin="0,0,5,0" Opacity="0.85" VerticalAlignment="Center"
                               Visibility="{Binding SourceIcon, Converter={StaticResource NullVis}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding SourceLabel, Converter={StaticResource NullVis}}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" ClipToBounds="True" VerticalAlignment="Center">
                            <Border CornerRadius="4" Padding="6,0,6,1" Margin="0,0,4,0" Background="{Binding TypeSoft}">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding TypeBrush}"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource InfoTag}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding AgoText}" FontSize="11" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="Title" Text="{Binding LinkHost}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="Body" local:Highlighter.Text="{Binding Preview}" TextWrapping="NoWrap" FontSize="14"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg}"/>
                    <Border x:Name="Thumb" Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}" CornerRadius="6"
                            HorizontalAlignment="Left" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource ActionButton}" Click="OnActionClick"/>
                    <Button Style="{StaticResource PinButton}" Click="OnPinClick"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Card}" Value="Image">
                    <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UseMono}" Value="True">
                    <Setter TargetName="Body" Property="FontFamily" Value="{StaticResource Mono}"/>
                    <Setter TargetName="Body" Property="FontSize" Value="13"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Link">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE71B;"/>
                    <Setter TargetName="Title" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Muted}"/>
                    <Setter TargetName="Body" Property="FontSize" Value="12"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Color">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadBox" Property="Background" Value="{Binding Swatch}"/>
                    <Setter TargetName="Body" Property="FontFamily" Value="{StaticResource Mono}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Email">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE715;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Phone">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE717;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Files">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE8B7;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Compact list row: one line per item -->
        <DataTemplate x:Key="CompactRowTemplate" DataType="{x:Type local:ClipItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Badge}" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Badge}" Style="{StaticResource KeyCapText}"/>
                </Border>
                <Grid x:Name="Lead" Grid.Column="1" Width="22" Height="22" Margin="0,0,9,0" Visibility="Collapsed">
                    <Border x:Name="LeadBox" CornerRadius="5" Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                    <TextBlock x:Name="LeadGlyph" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding LeadImage, Converter={StaticResource NullVis}, ConverterParameter=invert}"/>
                    <Image Source="{Binding LeadImage}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"
                           Style="{StaticResource LeadIcon}"/>
                    <Border CornerRadius="5" Visibility="{Binding LeadPhoto, Converter={StaticResource BoolVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding LeadImage}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <Border x:Name="Thumb" Grid.Column="1" Width="36" Height="22" CornerRadius="4" Margin="0,0,9,0" Visibility="Collapsed"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="Body" Grid.Column="2" local:Highlighter.Text="{Binding PreviewLine}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding AgoText}" Foreground="{DynamicResource Muted}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Style="{StaticResource ActionButton}" Width="24" Height="24" Click="OnActionClick"/>
                    <Button Style="{StaticResource PinButton}" Width="24" Height="24" Click="OnPinClick"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Card}" Value="Image">
                    <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UseMono}" Value="True">
                    <Setter TargetName="Body" Property="FontFamily" Value="{StaticResource Mono}"/>
                    <Setter TargetName="Body" Property="FontSize" Value="12"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Link">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE71B;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Color">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadBox" Property="Background" Value="{Binding Swatch}"/>
                    <Setter TargetName="Body" Property="FontFamily" Value="{StaticResource Mono}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Email">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE715;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Phone">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE717;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Card}" Value="Files">
                    <Setter TargetName="Lead" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LeadGlyph" Property="Text" Value="&#xE8B7;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Image grid tile content -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:ClipItem}">
            <Grid Height="104">
                <Border CornerRadius="6" Background="{DynamicResource Panel}"/>
                <Border CornerRadius="6">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.Background>
                </Border>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Bg}" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="5">
                    <TextBlock Text="{Binding Badge}" Style="{StaticResource KeyCapText}"/>
                </Border>
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Bg}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="5" Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE840;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource Surface}">
        <!-- Everything inside Body fades and slides in when the popup opens -->
        <Grid x:Name="Body">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BodyShift"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <Border Margin="12,12,12,8" Background="{DynamicResource Panel}" CornerRadius="8" Padding="10,0,4,0"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                             SelectionBrush="{DynamicResource Accent}"
                             Padding="0,9" VerticalContentAlignment="Center" TextChanged="OnSearchChanged"/>
                    <TextBlock Grid.Column="1" Text="Search, or filter: app:chrome  type:link  today" Foreground="{DynamicResource Muted}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Content="&#xE711;" FontSize="10" Width="24" Height="24" ToolTip="Clear (Esc)"
                            Click="OnClearSearch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Filter tabs (Tab / Shift+Tab to switch) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,4" Background="Transparent"
                        MouseLeftButtonDown="OnDragArea">
                <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" Content="All" Tag="All" IsChecked="True" Checked="OnFilterChecked"/>
                <RadioButton x:Name="FilterText" Style="{StaticResource Chip}" Content="Text" Tag="Text" Checked="OnFilterChecked"/>
                <RadioButton x:Name="FilterImages" Style="{StaticResource Chip}" Content="Images" Tag="Images" Checked="OnFilterChecked"/>
                <RadioButton x:Name="FilterFiles" Style="{StaticResource Chip}" Content="Files" Tag="Files" Checked="OnFilterChecked"/>
                <RadioButton x:Name="FilterPinned" Style="{StaticResource Chip}" Content="Pinned" Tag="Pinned" Checked="OnFilterChecked"/>
            </StackPanel>

            <!-- History -->
            <ListBox x:Name="List" Grid.Row="2" Margin="8,0,2,0" Background="Transparent" BorderThickness="0"
                     Focusable="False" ItemContainerStyle="{StaticResource RowStyle}" ItemTemplate="{StaticResource RowTemplate}"
                     ItemsPanel="{StaticResource ListPanel}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                                           Margin="12,10,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <!-- Empty states -->
            <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="30,0,30,30" Visibility="Collapsed">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyGlyph" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyTitle" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="280"/>
            </StackPanel>

            <!-- Full preview (Space) -->
            <Grid x:Name="PreviewPane" Grid.Row="2" Margin="12,4,12,8" Visibility="Collapsed"
                  DataContext="{Binding SelectedItem, ElementName=List}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,150,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#xE74A; &#xE74B;" Style="{StaticResource KeyCapIcon}"/></Border>
                        <TextBlock Text="Next" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,10,0"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Space" Style="{StaticResource KeyCapText}"/></Border>
                        <TextBlock Text="Close" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10">
                    <Grid>
                        <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsTextLike, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding FullText}" TextWrapping="Wrap" Foreground="{DynamicResource Fg}"
                                       FontFamily="{StaticResource Mono}" FontSize="12"/>
                        </ScrollViewer>
                        <Image Source="{Binding FullImage}" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Editor (F2) -->
            <Grid x:Name="EditorPane" Grid.Row="2" Margin="12,4,12,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+S" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Save" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,10,0"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+Enter" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Save and paste" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,10,0"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Cancel" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="EditorBox" Grid.Row="1" Style="{StaticResource Field}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="{StaticResource Mono}" FontSize="12" Padding="10,8"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnEditCancel"/>
                    <Button Content="Save" Style="{StaticResource SecondaryButton}" Margin="6,0" Click="OnEditSave"/>
                    <Button Content="Save and paste" Style="{StaticResource PrimaryButton}" Click="OnEditSavePaste"/>
                </StackPanel>
            </Grid>

            <!-- Image editor (F2 on an image) -->
            <Grid x:Name="ImageEditorPane" Grid.Row="2" Margin="12,4,12,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ToolCrop" Style="{StaticResource Chip}" GroupName="ImgTool" IsChecked="True" Checked="OnImgToolChanged">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A8;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0"/>
                                <TextBlock Text="Crop"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ToolBlur" Style="{StaticResource Chip}" GroupName="ImgTool" Checked="OnImgToolChanged">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE727;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0"/>
                                <TextBlock Text="Blur"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Rotate (R)" Click="OnImgRotate" Margin="6,0,0,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="OnImgUndo"/>
                    </StackPanel>
                    <TextBlock x:Name="ImgInfo" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="8" ClipToBounds="True">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="EditImage" Stretch="Uniform" StretchDirection="DownOnly" Cursor="Cross"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="OnImgMouseDown" MouseMove="OnImgMouseMove" MouseLeftButtonUp="OnImgMouseUp"/>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="ImgSelection" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                       Fill="{DynamicResource AccentSoft}" StrokeDashArray="4 2" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="ImgHint" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"
                               Text="Drag over the image to crop it"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnImgCancel"/>
                        <Button Content="Save" Style="{StaticResource SecondaryButton}" Margin="6,0" Click="OnImgSave"/>
                        <Button Content="Save and paste" Style="{StaticResource PrimaryButton}" Click="OnImgSavePaste"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Footer: shortcut hints drawn as keys -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,7,6,7"
                    Background="Transparent" MouseLeftButtonDown="OnDragArea">
                <Grid>
                    <StackPanel x:Name="FooterHints" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0,11,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#xE751;" Style="{StaticResource KeyCapIcon}"/></Border>
                        <TextBlock Text="Paste"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#xE752; &#xE751;" Style="{StaticResource KeyCapIcon}"/></Border>
                        <TextBlock Text="Plain"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Space" Style="{StaticResource KeyCapText}" Margin="0"/></Border>
                        <TextBlock Text="Preview"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="F2" Style="{StaticResource KeyCapText}" Margin="0"/></Border>
                        <TextBlock Text="Edit"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Tab" Style="{StaticResource KeyCapText}" Margin="0"/></Border>
                        <TextBlock Text="Filter"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE712;"
                            ToolTip="Settings and more" Click="OnMenuClick"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
